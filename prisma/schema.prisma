generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  TIKTOK
  INSTAGRAM
}

enum Ownership {
  OWNED
  CREATOR
}

enum SyncStatus {
  IDLE
  RUNNING
  OK
  ERROR
}

model Workspace {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  createdAt         DateTime  @default(now())
  /// Crédits restants chez le fournisseur de données, mis à jour à chaque appel API.
  providerCredits   Int?
  providerCreditsAt DateTime?
  users     User[]
  accounts  Account[]
  creators  Creator[]
  syncRuns  SyncRun[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

/// A person (external creator / UGC / clipper) who runs one or more accounts for the brand.
model Creator {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  notes       String?
  createdAt   DateTime  @default(now())
  accounts    Account[]

  @@index([workspaceId])
}

model Account {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform     Platform
  handle       String
  displayName  String?
  avatarUrl    String?
  profileUrl   String?
  bio          String?
  ownership    Ownership  @default(OWNED)
  creatorId    String?
  creator      Creator?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  followers    Int        @default(0)
  isActive     Boolean    @default(true)
  syncStatus   SyncStatus @default(IDLE)
  syncError    String?
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  posts        Post[]
  snapshots    AccountSnapshot[]

  @@unique([workspaceId, platform, handle])
  @@index([workspaceId])
}

model Post {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId   String
  url          String
  caption      String?
  thumbnailUrl String?
  publishedAt  DateTime
  views        Int      @default(0)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  saves        Int      @default(0)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  snapshots    PostSnapshot[]

  @@unique([accountId, externalId])
  @@index([accountId, publishedAt])
  @@index([publishedAt])
}

/// Point-in-time metrics for a post, taken at each sync. Deltas between snapshots give daily views.
model PostSnapshot {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  views      Int
  likes      Int
  comments   Int
  shares     Int
  saves      Int

  @@index([postId, capturedAt])
  @@index([capturedAt])
}

model AccountSnapshot {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  followers  Int
  totalViews Int
  totalLikes Int
  totalPosts Int

  @@index([accountId, capturedAt])
  @@index([capturedAt])
}

model SyncRun {
  id             String     @id @default(cuid())
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  status         SyncStatus @default(RUNNING)
  accountsSynced Int        @default(0)
  accountsFailed Int        @default(0)
  trigger        String     @default("manual")
  error          String?

  @@index([workspaceId, startedAt])
}
